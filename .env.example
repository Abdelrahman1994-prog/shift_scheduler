# Copy this file to .env and adjust before running the app.

# Port the app listens on
PORT=4000

# Postgres connection string. Locally, point this at your own Postgres (e.g.
# a docker run postgres:16 container). On Render, use the Internal
# Database URL from your Postgres instance's dashboard.
DATABASE_URL=postgres://postgres:devpassword@localhost:5433/shift_scheduler

# Long random string used to sign session cookies. Change this.
SESSION_SECRET=change-this-to-a-long-random-string

# Seeded admin account (created the first time you run `npm run seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Optional: Slack incoming webhook URL. If set, the weekly schedule is
# posted automatically when you click "Publish" on the schedule page.
# Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
