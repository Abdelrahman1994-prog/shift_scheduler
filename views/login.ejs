<%- include('partials/head', { title: 'Log in' }) %>
<div class="auth-wrap">
  <div class="auth-card">
    <h1>Shift Scheduler</h1>
    <div class="sub">Sign in to view or manage your schedule</div>
    <% if (typeof notice !== 'undefined' && notice) { %><div class="flash info"><%= notice %></div><% } %>
    <% if (error) { %><div class="flash error"><%= error %></div><% } %>
    <form method="post" action="/login">
      <div class="field">
        <label for="username">Email</label>
        <input type="email" id="username" name="username" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      <button class="btn primary" type="submit">Log in</button>
    </form>
  </div>
</div>
</body>
</html>
