<%- include('partials/head', { title: title }) %>
<%- include('partials/nav', { active: active, currentUser: currentUser, flash: flash }) %>

<div class="page-head">
  <div>
    <h1>Leave balance</h1>
    <p>Annual entitlement vs. approved leave taken, month by month. Day counts are working days only — Friday and Saturday are excluded.</p>
  </div>
  <div class="actions">
    <a class="btn small" href="/leave">← Back to leave</a>
  </div>
</div>

<div class="card">
  <form method="get" action="/leave/balance" class="field-row" style="align-items:flex-end;">
    <% if (canApprove) { %>
      <div class="field" style="margin-bottom:0;">
        <label>Member</label>
        <select name="member_id" onchange="this.form.submit()">
          <% members.forEach(m => { %><option value="<%= m.id %>" <%= member.id === m.id ? 'selected' : '' %>><%= m.name %></option><% }) %>
        </select>
      </div>
    <% } %>
    <input type="hidden" name="year" value="<%= year %>">
    <div class="field" style="margin-bottom:0;">
      <label>Year</label>
      <div class="week-nav">
        <a class="btn small" href="/leave/balance?member_id=<%= member.id %>&year=<%= prevYear %>">← <%= prevYear %></a>
        <span class="mono"><%= year %></span>
        <a class="btn small" href="/leave/balance?member_id=<%= member.id %>&year=<%= nextYear %>"><%= nextYear %> →</a>
      </div>
    </div>
  </form>
</div>

<div class="card">
  <div class="card-head">
    <h2><%= member.name %></h2>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Month</th>
          <th>From</th><th>To</th>
          <th>From</th><th>To</th>
          <th>From</th><th>To</th>
          <th>From</th><th>To</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% months.forEach(m => { %>
          <tr>
            <td><strong><%= m.label %></strong></td>
            <% for (let i = 0; i < 4; i++) { %>
              <% const p = m.periods[i]; %>
              <td class="mono"><%= p ? p.fromLabel : '' %></td>
              <td class="mono"><%= p ? p.toLabel : '' %></td>
            <% } %>
            <td class="mono" style="font-weight:700;<%= m.total > 0 ? 'color:var(--accent-ink);' : '' %>">
              <%= m.total || '' %>
              <% if (m.periods.length > 4) { %><span class="hint">(+<%= m.periods.length - 4 %> more)</span><% } %>
            </td>
          </tr>
        <% }) %>
        <tr style="background:var(--paper);">
          <td colspan="9" style="text-align:right;font-weight:700;">TOTAL</td>
          <td class="mono" style="font-weight:700;color:var(--red);"><%= grandTotal %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="grid-3" style="margin-top:20px;margin-bottom:0;">
    <div class="stat"><div class="num"><%= startingBalance %></div><div class="label">Starting balance</div></div>
    <div class="stat"><div class="num"><%= grandTotal %></div><div class="label">Planned / taken this year</div></div>
    <div class="stat <%= remaining < 0 ? 'warn' : '' %>"><div class="num"><%= remaining %></div><div class="label">Remaining balance</div></div>
  </div>

  <div class="flash info" style="margin-top:20px;direction:rtl;text-align:right;">
    يجب على الموظف التقدم بطلب الإجازة مسبقًا عبر نظام الإجازات المعتمد، وذلك قبل القيام بأي إجازة.
    <br>
    <a href="https://qeemanet.sharepoint.com/sites/EmployeeInternalLibrary" target="_blank" rel="noopener" style="font-weight:600;">نظام الإجازات المعتمد ↗</a>
  </div>
</div>

<%- include('partials/foot') %>
