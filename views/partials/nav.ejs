<% const initials = currentUser.name.trim().split(/\s+/).map(n => n[0]).slice(0, 2).join('').toUpperCase(); %>
<div class="app-shell">
  <div class="mobile-topbar">
    <button class="icon-btn" id="navToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="brand">Shift<span>Scheduler</span></div>
  </div>

  <div class="sidenav-overlay" id="navOverlay"></div>

  <nav class="sidebar" id="sidebar">
    <div class="brand">Shift<span>Scheduler</span></div>

    <div class="nav-links">
      <a class="nav-link <%= active === 'dashboard' ? 'active' : '' %>" href="/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"/></svg>
        <span>Dashboard</span>
      </a>
      <a class="nav-link <%= active === 'oncall' ? 'active' : '' %>" href="/oncall">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 3.5c1.2 0 1.4.9 1.9 2.1.4 1 .8 1.9-.1 2.7-1.3 1.2-1.1 2.6.4 4.1s2.9 1.7 4.1.4c.8-.9 1.7-.5 2.7-.1 1.2.5 2.1.7 2.1 1.9 0 2.2-1.8 4-4 4-7.2 0-13-5.8-13-13 0-2.2 1.8-4 4-4z"/></svg>
        <span>On-call now</span>
      </a>
      <a class="nav-link <%= active === 'schedule' ? 'active' : '' %>" href="/schedule">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><line x1="3" y1="9.5" x2="21" y2="9.5"/><line x1="8" y1="2.5" x2="8" y2="6.5"/><line x1="16" y1="2.5" x2="16" y2="6.5"/></svg>
        <span>Schedule</span>
      </a>
      <a class="nav-link <%= active === 'leave' ? 'active' : '' %>" href="/leave">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2.5" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="21.5"/><line x1="4.2" y1="4.2" x2="6" y2="6"/><line x1="18" y1="18" x2="19.8" y2="19.8"/><line x1="2.5" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="21.5" y2="12"/></svg>
        <span>Vacation &amp; leave</span>
      </a>
      <a class="nav-link <%= active === 'swaps' ? 'active' : '' %>" href="/swaps">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h14l-3.5-3.5"/><path d="M20 16H6l3.5 3.5"/></svg>
        <span>Swap requests</span>
      </a>
      <a class="nav-link <%= active === 'profile' ? 'active' : '' %>" href="/profile">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="10.5" r="2"/><path d="M5.5 16c.5-2 1.5-3 3-3s2.5 1 3 3"/><line x1="13.5" y1="9" x2="18" y2="9"/><line x1="13.5" y1="12" x2="18" y2="12"/></svg>
        <span>My profile</span>
      </a>
      <% if (currentUser.role === 'admin') { %>
        <a class="nav-link <%= active === 'members' ? 'active' : '' %>" href="/members">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.25"/><path d="M3.5 20c0-3.6 2.5-6 5.5-6s5.5 2.4 5.5 6"/><path d="M16 8.5a2.75 2.75 0 1 1 0-5.4"/><path d="M15 14.3c2.5.4 4.5 2.6 4.5 5.7"/></svg>
          <span>Members</span>
        </a>
        <a class="nav-link <%= active === 'projects' ? 'active' : '' %>" href="/projects">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg>
          <span>Projects</span>
        </a>
        <a class="nav-link <%= active === 'settings' ? 'active' : '' %>" href="/settings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.25"/><path d="M12 3v2.4M12 18.6V21M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M3 12h2.4M18.6 12H21M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7"/></svg>
          <span>Settings</span>
        </a>
      <% } %>
    </div>

    <div class="nav-spacer"></div>

    <button class="theme-toggle-row" id="themeToggle" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5a8.5 8.5 0 0 0 0 17z" fill="currentColor" stroke="none"/></svg>
      <span>Toggle light / dark</span>
    </button>

    <div class="nav-foot">
      <div class="user-row">
        <div class="avatar"><%= initials %></div>
        <div>
          <div class="who"><%= currentUser.name %></div>
          <div class="role"><%= currentUser.role %></div>
        </div>
      </div>
      <form method="post" action="/logout"><button class="btn small" type="submit" style="width:100%;">Log out</button></form>
    </div>
  </nav>
  <main class="main">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash <%= flash.type %>"><%= flash.message %></div>
    <% } %>
